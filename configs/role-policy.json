{
  "schema_version": 2,
  "mode": "shadow",
  "provider_aliases": {
    "ccsub": "sub2api"
  },
  "candidate_gate": {
    "min_samples_per_model": 10,
    "min_success_rate": 0.9,
    "min_quality_score": 4.0,
    "min_distinct_tasks": 3
  },
  "canary_gate": {
    "min_samples_per_model": 20,
    "min_success_rate": 0.92,
    "min_quality_score": 4.2,
    "min_cost_saving": 0.15,
    "max_rework_increase": 0.2,
    "max_regression_rate": 0.05
  },
  "auto_promote_gate": {
    "min_samples_per_model": 30,
    "min_success_rate": 0.95,
    "min_quality_score": 4.3,
    "min_cost_saving": 0.2,
    "max_quality_drop": 0,
    "max_p95_latency_ratio": 1.2,
    "max_regression_rate": 0.03,
    "max_rework_increase": 0,
    "min_distinct_tasks": 5
  },
  "auto_promote_roles": ["explorer", "implementer", "e2e"],
  "manual_approval_roles": ["researcher", "planner", "reviewer"],
  "rollback": {
    "consecutive_failures": 2,
    "recent_window": 5,
    "recent_success_rate": 0.8,
    "quality_drop": 0.3,
    "max_regression_rate": 0.05,
    "cooldown_days": 7
  },
  "providers": {
    "aihubmix": {
      "catalog_endpoint": "https://aihubmix.com/v1/models",
      "roles": {
        "planner": {
          "default_model": "gpt-6-sol",
          "candidates": ["gpt-6-sol", "kimi-k3", "glm-5.3"]
        },
        "researcher": {
          "default_model": "kimi-k3",
          "candidates": ["kimi-k3", "gpt-6-sol", "glm-5.3"]
        },
        "explorer": {
          "default_model": "deepseek-v4.1-flash",
          "candidates": ["deepseek-v4.1-flash", "deepseek-v4-pro", "coding-glm-5.3"]
        },
        "implementer": {
          "default_model": "deepseek-v4.1-flash",
          "candidates": ["deepseek-v4.1-flash", "deepseek-v4-pro", "coding-kimi-k3", "coding-glm-5.3"]
        },
        "e2e": {
          "default_model": "claude-opus-5-5",
          "candidates": ["claude-opus-5-5", "gpt-6-sol", "kimi-k3"]
        },
        "reviewer": {
          "default_model": "gpt-6-sol",
          "candidates": ["gpt-6-sol", "claude-opus-5-5", "glm-5.3"]
        }
      }
    },
    "sub2api": {
      "catalog_endpoint": "https://ccsub.inferera.com/v1/models",
      "api_key_env": "AIHUBMIX_SUB_CX_API_KEY",
      "roles": {
        "planner": {
          "default_model": "gpt-6-sol",
          "candidates": ["gpt-6-sol", "gpt-5.6"]
        },
        "researcher": {
          "default_model": "gpt-6-sol",
          "candidates": ["gpt-6-sol", "gpt-5.6"]
        },
        "explorer": {
          "default_model": "gpt-6-sol",
          "candidates": ["gpt-6-sol", "gpt-5.3-codex-spark", "gpt-5.4-mini"]
        },
        "implementer": {
          "default_model": "gpt-6-sol",
          "candidates": ["gpt-6-sol", "gpt-5.3-codex-spark", "gpt-5.4-mini"]
        },
        "e2e": {
          "default_model": "gpt-6-sol",
          "candidates": ["gpt-6-sol", "gpt-5.6-terra"]
        },
        "reviewer": {
          "default_model": "gpt-6-sol",
          "candidates": ["gpt-6-sol", "codex-auto-review"]
        }
      }
    },
    "openrouter": {
      "catalog_endpoint": "https://openrouter.ai/api/v1/models",
      "api_key_env": "OPENROUTER_API_KEY",
      "roles": {
        "planner": {
          "default_model": "z-ai/glm-5.3",
          "candidates": ["z-ai/glm-5.3", "moonshotai/kimi-k3", "deepseek/deepseek-v4.1-flash"]
        },
        "researcher": {
          "default_model": "moonshotai/kimi-k3",
          "candidates": ["moonshotai/kimi-k3", "z-ai/glm-5.3", "deepseek/deepseek-v4.1-flash"]
        },
        "explorer": {
          "default_model": "deepseek/deepseek-v4.1-flash",
          "candidates": ["deepseek/deepseek-v4.1-flash", "z-ai/glm-5.3", "moonshotai/kimi-k3"]
        },
        "implementer": {
          "default_model": "deepseek/deepseek-v4.1-flash",
          "candidates": ["deepseek/deepseek-v4.1-flash", "z-ai/glm-5.3", "moonshotai/kimi-k3"]
        },
        "e2e": {
          "default_model": "z-ai/glm-5.3",
          "candidates": ["z-ai/glm-5.3", "moonshotai/kimi-k3", "deepseek/deepseek-v4.1-flash"]
        },
        "reviewer": {
          "default_model": "z-ai/glm-5.3",
          "candidates": ["z-ai/glm-5.3", "moonshotai/kimi-k3", "deepseek/deepseek-v4.1-flash"]
        }
      }
    }
  }
}
